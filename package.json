{
  "name": "amp-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Durable pi agent harness on the Ampersand (humansand.ai) Agents API",
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "amp-harness": "./bin/amp-harness"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "harness": "node --experimental-strip-types src/cli.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@earendil-works/chord": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
