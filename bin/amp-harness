#!/bin/zsh
# amp-harness launcher. Key lookup: $AMPERSAND_API_KEY, then `amp-harness login`'s stored key.
# Fallback for non-interactive shells (which skip ~/.zshrc): if neither exists, load only the
# AMPERSAND_* exports from ~/.zshrc.
CRED="${AMP_HARNESS_CREDENTIALS:-${XDG_CONFIG_HOME:-$HOME/.config}/amp-harness/credentials.json}"
if [[ -z "$AMPERSAND_API_KEY" && ! -s "$CRED" && -f ~/.zshrc ]]; then
  eval "$(grep -E '^export AMPERSAND_[A-Z_]+=' ~/.zshrc)"
fi
HERE="${0:A:h}/.."
exec node --no-warnings=ExperimentalWarning --experimental-strip-types "$HERE/src/cli.ts" "$@"
